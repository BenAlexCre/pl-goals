# ==========================================================================
# PUBLIC FRONTEND VARIABLES
# ==========================================================================
# These are Vite build-time vars — anything prefixed VITE_ is inlined into
# the client-side JS bundle and shipped to every visitor's browser. Only
# put values here that are safe to be fully public. The anon key is safe by
# design: it identifies the project, not a privileged caller — real access
# control is enforced by Postgres RLS policies, not by keeping this secret.
#
# Local dev: put the real values in frontend/.env.local (gitignored, never
# this file).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Never add a VITE_-prefixed service-role key, database password, or any
# third-party API key here or in frontend/.env.local — a VITE_ prefix means
# Vite will embed it in the public bundle. Server/API secrets belong only
# in the section below, consumed exclusively by Edge Functions.

# ==========================================================================
# SERVER / SUPABASE SECRETS (Edge Functions only — never sent to the browser)
# ==========================================================================
# Local CLI dev: supabase/functions/.env (gitignored, never this file).
# Hosted: `supabase secrets set NAME=value` against the linked project —
# see docs/DEPLOYMENT.md § 5.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# football-data.org (api.football-data.org/v4) API key. Used by:
#   - supabase/functions/sync-fixtures (production, cron-scheduled)
#   - frontend/scripts/fullSyncInsert.js (standalone/manual use)
#   - frontend/scripts/fullSyncPlayers.js (standalone/manual use)
# sync-fixtures also accepts VITE_FOOTBALL_DATA_KEY as a fallback name for
# backward compatibility — set FOOTBALL_DATA_KEY going forward, not that one.
FOOTBALL_DATA_KEY=your-football-data-org-key-here

# football-data.org competition code, e.g. PL = Premier League. Optional —
# defaults to 'PL'; can also be overridden per-request via the function's
# JSON body ({"competitionCode": "..."}).
FOOTBALL_COMPETITION_CODE=PL

# football-data.org season start year, e.g. 2026 for the 2026/27 season.
# Optional — defaults to the current calendar year; can also be overridden
# per-request via the function's JSON body ({"seasonYear": ...}).
FOOTBALL_SEASON=2026

# No payment gateway and no SMTP/email provider secrets exist in this
# codebase today — payments are tracked manually (entry_payments.is_paid),
# and email delivery uses Supabase Auth's own hosted config (site_url,
# additional_redirect_urls, SMTP settings), which is configured in the
# Supabase dashboard, not as an app env var. See docs/DEPLOYMENT.md.
