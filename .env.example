# Frontend (Vite build-time — see frontend/.env.local for the actual local dev file)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Edge Functions (set via `supabase secrets set`, or supabase/functions/.env for
# local CLI dev — NOT this file; these names are documented here so the full set
# of required configuration is visible in one place, per docs/DEPLOYMENT.md § 5)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# sync-fixtures only. Read as VITE_FOOTBALL_DATA_KEY despite the prefix — that's
# a naming holdover in supabase/functions/sync-fixtures/index.ts, not a typo here.
# This is an api-football.com (v3.football.api-sports.io) key, not football-data.org.
VITE_FOOTBALL_DATA_KEY=your-api-football-key-here

# sync-fixtures only, optional — numeric api-football league ID (e.g. 39 = Premier
# League). Falls back to the request body's competitionId, then to 'WC' if unset.
COMPETITION_ID=39
